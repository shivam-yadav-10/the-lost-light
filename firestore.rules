rules_version = '2';

// Deliberately permissive: the game engine (puzzle locking, answer validation, hint
// gating) now runs entirely in the browser client, not in these Rules. Any signed-in
// user (including anonymous sign-in) may read or write any document. This trades
// away tamper-resistance for a working deployment under deadline; do not treat this
// as a secure or anti-cheat boundary.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
