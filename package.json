{
  "name": "the-lost-light",
  "version": "0.1.0",
  "private": true,
  "description": "The Lost Light — Firebase-backed GTCI Diwali scavenger hunt",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:init": "npm run db:init --prefix backend",
    "db:reset": "npm run db:reset --prefix backend",
    "content:apply": "npm run content:apply --prefix backend",
    "content:check": "npm run content:check --prefix backend",
    "answer-key": "npm run answer-key --prefix backend",
    "firestore:seed": "npm run firestore:seed --prefix backend --",
    "progress:reset": "npm run progress:reset --prefix backend",
    "dev": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:test": "node scripts/test-server.mjs",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  }
}
