# Copy to backend/.env (or export in your shell). All values are optional for local dev.

# PORT=4000
# DB_PATH=./data/game.db
# CORS_ORIGIN=http://localhost:5173

# Organiser key for /#/admin and /api/admin/*. Default is `local-admin` for local dev only.
# Five wrong keys from one IP within 15 minutes lock that IP out for 15 minutes.
# ADMIN_KEY=<YOUR_ADMIN_KEY>

# Derives each team's Convergence lantern, key and seal. Use a long random value for the event and
# never change it after the Convergence opens. Default is `local-dev-secret` for local dev only.
# GAME_SECRET=<YOUR_GAME_SECRET>

# Freeze "now" to test scheduled unlocks, e.g. FAKE_NOW=2026-11-10T09:00:00+05:30
# FAKE_NOW=
